# Copy this file to .env and fill in values before running docker-compose.
# .env is gitignored — never commit credentials.

# ── MT5 Bridge (Windows native service, NOT in Docker) ───────────────────────
# URL containers use to reach the bridge running on the Windows host.
# On Docker Desktop for Windows this is always host.docker.internal.
MT5_BRIDGE_URL=http://host.docker.internal:8000

# Full path to the MT5 terminal executable on the Windows host.
# Used by the bridge service only.
MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=trader
POSTGRES_PASSWORD=changeme
POSTGRES_DB=mt5
POSTGRES_URL=postgresql://trader:changeme@postgres:5432/mt5

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Strategy mode (DB-controlled — NOT an env var) ───────────────────────────
# Strategy mode (live / shadow / off) is stored in the strategies table in
# Postgres and updated at runtime via the dashboard or db.swap_live_strategy().
# There is no MODE env var — all strategy containers publish to signals:all
# and the executor queries the DB on each signal to decide whether to execute.
# To promote a strategy: UPDATE strategies SET mode='live' WHERE name='ema-scalp';
# (or use the dashboard promote button which calls db.swap_live_strategy()).

# ── Strategy: EMA Scalp ───────────────────────────────────────────────────────
EMA_FAST=9
EMA_SLOW=21
EMA_TREND=50
RSI_PERIOD=14
RSI_MIN_BUY=55
RSI_MAX_SELL=45
EMA_SCALP_RISK_PCT=0.5
EMA_SCALP_RR_TARGET=1.5

# ── Strategy: Liquidity Sweep ────────────────────────────────────────────────
LIQ_SWEEP_PIVOT_LEFT=5
LIQ_SWEEP_PIVOT_RIGHT=3
LIQ_SWEEP_ZONE_TOLERANCE=10
LIQ_SWEEP_RISK_PCT=0.5
LIQ_SWEEP_RR_TARGET=2.0

# ── Strategy: OB + FVG ───────────────────────────────────────────────────────
OB_FVG_MIN_IMPULSE_POINTS=50
OB_FVG_MIN_GAP_POINTS=10
OB_FVG_LOOKBACK=20
OB_FVG_RISK_PCT=0.5
OB_FVG_RR_TARGET=2.0

# ── Dashboard ────────────────────────────────────────────────────────────────
DASHBOARD_PORT=3000
